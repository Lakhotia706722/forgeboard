# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# For local Docker Compose setup, the compose file injects overrides automatically.
# Use this only when running outside Docker.
DATABASE_URL=postgresql+asyncpg://forgeboard:forgeboard@localhost:5432/forgeboard

# ── Queue / Celery (Redis) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Single provider for MVP — BYON (Bring Your Own Network) deferred.
ANTHROPIC_API_KEY=sk-ant-...

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠ MVP-grade: Fernet symmetric key stored in env. Upgrade to Vault/KMS before production.
FERNET_KEY=CHANGE_ME_FERNET_BASE64_KEY

# ── Google OAuth (Calendar + Gmail connectors) ────────────────────────────────
# Create credentials at https://console.cloud.google.com/ → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/oauth/google/callback

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list — frontend origin(s)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Concurrency ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS_PER_WORKSPACE=5

# ── Phase 8: Voice & Telephony ────────────────────────────────────────────────
# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567
# Public base URL Twilio posts webhooks to (use ngrok for local dev)
# e.g. https://abc123.ngrok-free.app
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app

# STT provider: "deepgram"
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# TTS provider: "elevenlabs"
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Max concurrent calls per workspace
MAX_CONCURRENT_CALLS_PER_WORKSPACE=3
